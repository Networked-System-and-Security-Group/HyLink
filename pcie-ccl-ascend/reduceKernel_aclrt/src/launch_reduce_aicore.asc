#include "kernel_operator.h"
#include "launch_reduce_aicore.h"
#include <algorithm>
#include <cstdlib>

namespace {

constexpr uint32_t kBufferNum = 2;
constexpr uint32_t kTileElements = 8192;
// Model the two L2 tiles explicitly.  The hardware/runtime does not expose an
// L2 slice id to this direct-launch kernel, so the outer loop below provides a
// stable slice id that can rotate each slice's remainder across AIV blocks.
constexpr uint32_t kL2SplitCount = 2;

enum class ReduceOperation : uint32_t {
  Sum,
  Max,
  Min,
};

template <typename T>
struct IsBfloat16 {
  static constexpr bool value = false;
};

template <>
struct IsBfloat16<bfloat16_t> {
  static constexpr bool value = true;
};

template <typename T, ReduceOperation Operation>
class ReduceKernel {
 public:
  __aicore__ inline void Init(GM_ADDR dst, GM_ADDR src, uint64_t elements) {
    const uint32_t block_count = AscendC::GetBlockNum();
    const uint32_t block_index = AscendC::GetBlockIdx();
    elements_ = elements;
    block_count_ = block_count;
    block_index_ = block_index;
    const uint64_t total_bytes = elements * sizeof(T);
    // Keep this q/r calculation in lockstep with
    // pccl_aicore_reduce.h::GetAicoreReducePartition().  The first r blocks
    // receive one additional 32-byte unit, instead of concentrating the
    // rounding remainder on the last block.
    const uint64_t aligned_bytes = total_bytes & ~uint64_t{31};
    const uint64_t aligned_units = aligned_bytes / 32;
    const uint64_t units_per_block = block_count == 0 ? 0 : aligned_units / block_count;
    const uint32_t extra_units = block_count == 0 ? 0 : aligned_units % block_count;
    const uint64_t begin_units = units_per_block * block_index +
                                 (block_index < extra_units ? block_index : extra_units);
    const uint64_t end_units = begin_units + units_per_block +
                               (block_index < extra_units ? 1 : 0);
    start_ = (begin_units * 32) / sizeof(T);
    end_ = (end_units * 32) / sizeof(T);

    // Keep the short, non-32-byte suffix disjoint.  Its owner range is rotated
    // after the second L2 slice, so two consecutive slice tails do not always
    // hit the same physical AIV.
    const uint64_t aligned_elements = (total_bytes & ~uint64_t{31}) / sizeof(T);
    const uint32_t tail_total = static_cast<uint32_t>(elements - aligned_elements);
    const uint32_t tail_base = block_count == 0 ? 0 : tail_total / block_count;
    const uint32_t tail_extra = block_count == 0 ? 0 : tail_total % block_count;
    const uint32_t tail_offset = block_count == 0 ? 0 : (tail_extra % block_count);
    tail_prefix_ = tail_base * block_index +
                   CountExtraBefore(block_index, tail_extra, tail_offset, block_count);
    tail_start_ = aligned_elements + tail_prefix_;
    tail_elements_ = tail_base +
                     HasExtra(block_index, tail_extra, tail_offset, block_count);

    dst_gm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(dst), elements);
    src_gm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(src), elements);
    pipe_.InitBuffer(src_queue_, kBufferNum, kTileElements * sizeof(T));
    pipe_.InitBuffer(dst_queue_, kBufferNum, kTileElements * sizeof(T));
    pipe_.InitBuffer(out_queue_, kBufferNum, kTileElements * sizeof(T));
    if constexpr (IsBfloat16<T>::value) {
      pipe_.InitBuffer(src_float_buf_, kTileElements * sizeof(float));
      pipe_.InitBuffer(dst_float_buf_, kTileElements * sizeof(float));
    }
  }

  __aicore__ inline void Process() {
    if (block_count_ <= 1) {
      ProcessRange(start_, end_, false);
    } else {
      // Split the aligned region into two L2-sized pieces.  For each piece,
      // q/r is calculated independently and the r extra units are rotated by
      // slice.  With two cores and one extra unit this maps slice 0 to core 0
      // and slice 1 to core 1, instead of repeatedly using core 0.
      const uint64_t aligned_units = (elements_ * sizeof(T)) / 32;
      const uint64_t split_base = aligned_units / kL2SplitCount;
      const uint32_t split_extra = aligned_units % kL2SplitCount;
      uint64_t split_begin = 0;
      for (uint32_t split = 0; split < kL2SplitCount; ++split) {
        const uint64_t split_units = split_base + (split < split_extra ? 1 : 0);
        const uint64_t units_per_block = split_units / block_count_;
        const uint32_t extra_units = split_units % block_count_;
        const uint32_t offset = (extra_units * split) % block_count_;
        const uint64_t begin_units = split_begin + units_per_block * block_index_ +
                                     CountExtraBefore(block_index_, extra_units, offset, block_count_);
        const uint64_t end_units = begin_units + units_per_block +
                                   HasExtra(block_index_, extra_units, offset, block_count_);
        ProcessRange((begin_units * 32) / sizeof(T), (end_units * 32) / sizeof(T), false);
        split_begin += split_units;
      }
    }

    if (tail_elements_ != 0)
      ProcessRange(tail_start_, tail_start_ + tail_elements_, true);
  }

 private:
  __aicore__ inline bool HasExtra(uint32_t core, uint32_t extra, uint32_t offset,
                                  uint32_t block_count) const {
    if (extra == 0 || block_count == 0)
      return false;
    const uint32_t distance = (core + block_count - offset) % block_count;
    return distance < extra;
  }

  __aicore__ inline uint32_t CountExtraBefore(uint32_t core, uint32_t extra, uint32_t offset,
                                              uint32_t block_count) const {
    uint32_t count = 0;
    for (uint32_t index = 0; index < core; ++index)
      count += HasExtra(index, extra, offset, block_count) ? 1 : 0;
    return count;
  }

  __aicore__ inline void ProcessRange(uint64_t start, uint64_t end, bool padded_tail) {
    if (end <= start)
      return;
    const uint32_t range_elements = static_cast<uint32_t>(end - start);
    const uint32_t tile_count = (range_elements + kTileElements - 1) / kTileElements;
    for (uint32_t tile = 0; tile < tile_count && tile < kBufferNum; ++tile) {
      const uint32_t offset = tile * kTileElements;
      const uint32_t tile_elements =
          offset + kTileElements <= range_elements ? kTileElements : range_elements - offset;
      CopyIn(start + offset, tile_elements, padded_tail);
    }
    for (uint32_t tile = 0; tile < tile_count; ++tile) {
      const uint32_t offset = tile * kTileElements;
      const uint32_t tile_elements =
          offset + kTileElements <= range_elements ? kTileElements : range_elements - offset;
      Compute(tile_elements);
      const uint32_t next_tile = tile + kBufferNum;
      if (next_tile < tile_count) {
        const uint32_t next_offset = next_tile * kTileElements;
        const uint32_t next_elements = next_offset + kTileElements <= range_elements
                                           ? kTileElements
                                           : range_elements - next_offset;
        CopyIn(start + next_offset, next_elements, padded_tail);
      }
      CopyOut(start + offset, tile_elements, padded_tail);
    }
  }

  __aicore__ inline void CopyIn(uint64_t position, uint32_t elements, bool padded_tail) {
    AscendC::LocalTensor<T> src_local = src_queue_.AllocTensor<T>();
    AscendC::LocalTensor<T> dst_local = dst_queue_.AllocTensor<T>();
    if (padded_tail) {
      const uint32_t byte_count = elements * sizeof(T);
      const uint8_t right_padding =
          static_cast<uint8_t>((32 - byte_count % 32) % 32 / sizeof(T));
      const AscendC::DataCopyExtParams copy_params{1, byte_count, 0, 0, 0};
      const AscendC::DataCopyPadExtParams<T> pad_params{true, 0, right_padding, 0};
      AscendC::DataCopyPad(src_local, src_gm_[position], copy_params, pad_params);
      AscendC::DataCopyPad(dst_local, dst_gm_[position], copy_params, pad_params);
    } else {
      AscendC::DataCopy(src_local, src_gm_[position], elements);
      AscendC::DataCopy(dst_local, dst_gm_[position], elements);
    }
    src_queue_.EnQue(src_local);
    dst_queue_.EnQue(dst_local);
  }

  __aicore__ inline void Compute(uint32_t elements) {
    AscendC::LocalTensor<T> src_local = src_queue_.DeQue<T>();
    AscendC::LocalTensor<T> dst_local = dst_queue_.DeQue<T>();
    if constexpr (IsBfloat16<T>::value) {
      AscendC::LocalTensor<float> src_float = src_float_buf_.Get<float>();
      AscendC::LocalTensor<float> dst_float = dst_float_buf_.Get<float>();
      AscendC::Cast(src_float, src_local, AscendC::RoundMode::CAST_NONE,
                    static_cast<int32_t>(elements));
      AscendC::Cast(dst_float, dst_local, AscendC::RoundMode::CAST_NONE,
                    static_cast<int32_t>(elements));
      if constexpr (Operation == ReduceOperation::Sum) {
        AscendC::Add(dst_float, dst_float, src_float, static_cast<int32_t>(elements));
      } else if constexpr (Operation == ReduceOperation::Max) {
        AscendC::Max(dst_float, dst_float, src_float, static_cast<int32_t>(elements));
      } else {
        AscendC::Min(dst_float, dst_float, src_float, static_cast<int32_t>(elements));
      }
      AscendC::LocalTensor<T> out_local = out_queue_.AllocTensor<T>();
      AscendC::Cast(out_local, dst_float, AscendC::RoundMode::CAST_RINT,
                    static_cast<int32_t>(elements));
      out_queue_.EnQue(out_local);
      src_float_buf_.FreeTensor(src_float);
      dst_float_buf_.FreeTensor(dst_float);
    } else {
      AscendC::LocalTensor<T> out_local = out_queue_.AllocTensor<T>();
      if constexpr (Operation == ReduceOperation::Sum) {
        AscendC::Add(out_local, dst_local, src_local, static_cast<int32_t>(elements));
      } else if constexpr (Operation == ReduceOperation::Max) {
        AscendC::Max(out_local, dst_local, src_local, static_cast<int32_t>(elements));
      } else {
        AscendC::Min(out_local, dst_local, src_local, static_cast<int32_t>(elements));
      }
      out_queue_.EnQue(out_local);
    }
    src_queue_.FreeTensor(src_local);
    dst_queue_.FreeTensor(dst_local);
  }

  __aicore__ inline void CopyOut(uint64_t position, uint32_t elements, bool padded_tail) {
    AscendC::LocalTensor<T> out_local = out_queue_.DeQue<T>();
    if (padded_tail) {
      const AscendC::DataCopyExtParams copy_params{
          1, static_cast<uint32_t>(elements * sizeof(T)), 0, 0, 0};
      AscendC::DataCopyPad(dst_gm_[position], out_local, copy_params);
    } else {
      AscendC::DataCopy(dst_gm_[position], out_local, elements);
    }
    out_queue_.FreeTensor(out_local);
  }

  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> src_queue_;
  AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> dst_queue_;
  AscendC::TQue<AscendC::TPosition::VECOUT, kBufferNum> out_queue_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> src_float_buf_;
  AscendC::TBuf<AscendC::TPosition::VECCALC> dst_float_buf_;
  AscendC::GlobalTensor<T> src_gm_;
  AscendC::GlobalTensor<T> dst_gm_;
  uint64_t start_ = 0;
  uint64_t end_ = 0;
  uint64_t elements_ = 0;
  uint32_t block_count_ = 0;
  uint32_t block_index_ = 0;
  uint64_t tail_start_ = 0;
  uint32_t tail_prefix_ = 0;
  uint32_t tail_elements_ = 0;
};

template <typename T, ReduceOperation Operation>
__aicore__ inline void RunReduce(GM_ADDR dst, GM_ADDR src, uint64_t elements) {
  ReduceKernel<T, Operation> kernel;
  kernel.Init(dst, src, elements);
  kernel.Process();
}

}  // namespace

#define DEFINE_REDUCE_KERNEL(NAME, TYPE, OPERATION) \
  extern "C" __global__ __aicore__ void NAME(GM_ADDR dst, GM_ADDR src, uint64_t elements, \
                                               GM_ADDR workspace, GM_ADDR tiling) { \
    (void)workspace; \
    (void)tiling; \
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY); \
    RunReduce<TYPE, OPERATION>(dst, src, elements); \
  }

DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloat16SumKernel, half, ReduceOperation::Sum)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloat16MaxKernel, half, ReduceOperation::Max)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloat16MinKernel, half, ReduceOperation::Min)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceBfloat16SumKernel, bfloat16_t, ReduceOperation::Sum)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceBfloat16MaxKernel, bfloat16_t, ReduceOperation::Max)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceBfloat16MinKernel, bfloat16_t, ReduceOperation::Min)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloatSumKernel, float, ReduceOperation::Sum)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloatMaxKernel, float, ReduceOperation::Max)
DEFINE_REDUCE_KERNEL(PcclAicoreReduceFloatMinKernel, float, ReduceOperation::Min)

namespace {

constexpr uint32_t kSingleAivThresholdBytes = 64 * 1024;
constexpr uint32_t kDefaultMaxReduceBlockDim = 24;

uint32_t SelectReduceBlockDim(uint64_t count_bytes) {
  if (count_bytes < kSingleAivThresholdBytes) {
    return 1;
  }
  static int configured_block_dim = -1;
  if (configured_block_dim == -1) {
    const char* env = std::getenv("PCCL_AICORE_REDUCE_BLOCK_DIM");
    if (env && *env != '\0') {
      configured_block_dim = std::atoi(env);
    }
    if (configured_block_dim <= 0) {
      configured_block_dim = kDefaultMaxReduceBlockDim;
    }
  }
  uint32_t max_blocks = static_cast<uint32_t>(count_bytes / (32 * 1024));
  if (max_blocks < 1) max_blocks = 1;
  return static_cast<uint32_t>(std::min(static_cast<uint32_t>(configured_block_dim), max_blocks));
}

template <typename Kernel>
aclError LaunchReduceKernel(Kernel kernel, void* dst, const void* src, uint64_t count_bytes,
                            uint64_t element_size, aclrtStream stream) {
  kernel<<<SelectReduceBlockDim(count_bytes), nullptr, stream>>>(
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(dst)),
      reinterpret_cast<GM_ADDR>(reinterpret_cast<uintptr_t>(const_cast<void*>(src))),
      count_bytes / element_size, nullptr, nullptr);
  return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}

}  // namespace

#define DEFINE_REDUCE_LAUNCHER(NAME, KERNEL, ELEMENT_SIZE) \
  aclError NAME(void* dst, const void* src, uint64_t count_bytes, aclrtStream stream) { \
    return LaunchReduceKernel(KERNEL, dst, src, count_bytes, ELEMENT_SIZE, stream); \
  }

DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloat16Sum, PcclAicoreReduceFloat16SumKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloat16Max, PcclAicoreReduceFloat16MaxKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloat16Min, PcclAicoreReduceFloat16MinKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceBfloat16Sum, PcclAicoreReduceBfloat16SumKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceBfloat16Max, PcclAicoreReduceBfloat16MaxKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceBfloat16Min, PcclAicoreReduceBfloat16MinKernel, sizeof(uint16_t))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloatSum, PcclAicoreReduceFloatSumKernel, sizeof(float))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloatMax, PcclAicoreReduceFloatMaxKernel, sizeof(float))
DEFINE_REDUCE_LAUNCHER(LaunchPcclAicoreReduceFloatMin, PcclAicoreReduceFloatMinKernel, sizeof(float))
