<?xml version="1.0" encoding="UTF-8"?>
<ir_program name="reducescatter" nranks="2" topology="1numa_2npu_per_numa" nnodes="1">
  <description>
    ReduceScatter with Ascend local D2DReduce. Source ranks move
    each destination segment to the destination NPU or its local NUMA
    host buffer; destination ranks accumulate locally with D2DReduce
    (dst += src). 
  </description>

  <rank id="0">
    <instruction op="D2H" src_chunk="1" dst_chunk="1" dst_numa="0"/>

    <instruction op="D2D" src_rank="0" src_buf="input" src_chunk="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="2" dst_buf="internal" dst_chunk="0" src_numa="0"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="0" dst_buf="output" dst_chunk="0"/>
  </rank>

  <rank id="1">
    <instruction op="D2H" src_chunk="0" dst_chunk="2" dst_numa="0"/>

    <instruction op="D2D" src_rank="1" src_buf="input" src_chunk="1" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="1" dst_buf="internal" dst_chunk="0" src_numa="0"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="0" dst_buf="output" dst_chunk="0"/>
  </rank>

</ir_program>
