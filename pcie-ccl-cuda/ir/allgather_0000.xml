<?xml version="1.0" encoding="UTF-8"?>
<ir_program name="allgather" nranks="4" topology="1numa_4gpu_per_numa" nnodes="1">
  <description>
    4-GPU AllGather: 1 NUMA node, 4 GPUs.
    Each rank contributes 1 chunk, output = 4 chunks per rank.
    Phase 1: D2H each GPU's data to its own host chunk
    Phase 2: D2D copy own chunk in output
    Phase 3: H2D other ranks' chunks from host
  </description>

  <rank id="0">
    <instruction op="D2H" src_chunk="0" dst_chunk="0" dst_numa="0"/>
    <instruction op="D2D" src_chunk="0" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="1" dst_chunk="1" src_numa="0"/>
    <instruction op="H2D" src_chunk="2" dst_chunk="2" src_numa="0"/>
    <instruction op="H2D" src_chunk="3" dst_chunk="3" src_numa="0"/>
  </rank>

  <rank id="1">
    <instruction op="D2H" src_chunk="0" dst_chunk="1" dst_numa="0"/>
    <instruction op="D2D" src_chunk="0" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="0" dst_chunk="0" src_numa="0"/>
    <instruction op="H2D" src_chunk="2" dst_chunk="2" src_numa="0"/>
    <instruction op="H2D" src_chunk="3" dst_chunk="3" src_numa="0"/>
  </rank>

  <rank id="2">
    <instruction op="D2H" src_chunk="0" dst_chunk="2" dst_numa="0"/>
    <instruction op="D2D" src_chunk="0" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="0" dst_chunk="0" src_numa="0"/>
    <instruction op="H2D" src_chunk="1" dst_chunk="1" src_numa="0"/>
    <instruction op="H2D" src_chunk="3" dst_chunk="3" src_numa="0"/>
  </rank>

  <rank id="3">
    <instruction op="D2H" src_chunk="0" dst_chunk="3" dst_numa="0"/>
    <instruction op="D2D" src_chunk="0" dst_chunk="3"/>
    <instruction op="H2D" src_chunk="0" dst_chunk="0" src_numa="0"/>
    <instruction op="H2D" src_chunk="1" dst_chunk="1" src_numa="0"/>
    <instruction op="H2D" src_chunk="2" dst_chunk="2" src_numa="0"/>
  </rank>
</ir_program>
