<?xml version="1.0" encoding="UTF-8"?>
<ir_program name="allreduce" nranks="2" topology="2numa_1gpu_per_numa" nnodes="1">
  <description>
    2-GPU cross-NUMA AllReduce fused as ReduceScatter plus AllGather.
    Each reduced chunk is produced on its owner GPU with D2DReduce and then
    gathered from the owner's local NUMA host buffer.
  </description>

  <rank id="0">
    <instruction op="D2H" src_chunk="1" dst_chunk="1" dst_numa="1"/>
    <instruction op="D2D" src_rank="0" src_buf="input" src_chunk="0" dst_buf="internal" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="2" src_numa="0" dst_buf="internal" dst_chunk="3"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="3" dst_buf="internal" dst_chunk="2"/>

    <instruction op="D2H" src_buf="internal" src_chunk="2" dst_chunk="4" dst_numa="0"/>
    <instruction op="D2D" src_buf="internal" src_chunk="2" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="5" src_numa="1" dst_buf="output" dst_chunk="1"/>
  </rank>

  <rank id="1">
    <instruction op="D2H" src_chunk="0" dst_chunk="2" dst_numa="0"/>
    <instruction op="D2D" src_rank="1" src_buf="input" src_chunk="1" dst_buf="internal" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="1" src_numa="1" dst_buf="internal" dst_chunk="3"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="3" dst_buf="internal" dst_chunk="2"/>

    <instruction op="D2H" src_buf="internal" src_chunk="2" dst_chunk="5" dst_numa="1"/>
    <instruction op="H2D" src_chunk="4" src_numa="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="D2D" src_buf="internal" src_chunk="2" dst_buf="output" dst_chunk="1"/>
  </rank>
</ir_program>
