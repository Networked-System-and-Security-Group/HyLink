<?xml version="1.0" encoding="UTF-8"?>
<ir_program name="allreduce" nranks="4" topology="1numa_4gpu_per_numa" variant="mesh" nnodes="1">
  <description>
    4-GPU AllReduce = mesh ReduceScatter + mesh AllGather through NUMA0 host
    staging (no cross-rank D2D). Rank r owns chunk r: peers stage chunk r in
    host chunk 4*s+r, rank r accumulates it into output chunk r with
    D2DReduce, publishes the result in host chunk 16+r, and every rank pulls
    the other final chunks with H2D. Per rank: 4 D2H + 6 H2D, vs 6 + 6 for
    the relay ring, and no serial ring dependency chain.
  </description>

  <rank id="0">
    <!-- ReduceScatter: stage peer-owned chunks. -->
    <instruction op="D2H" src_buf="input" src_chunk="1" dst_chunk="1" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="2" dst_chunk="2" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="3" dst_chunk="3" dst_numa="0"/>
    <instruction op="D2D" src_rank="0" src_buf="input" src_chunk="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="4" src_numa="0" dst_buf="internal" dst_chunk="1"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="1" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="8" src_numa="0" dst_buf="internal" dst_chunk="2"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="2" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="12" src_numa="0" dst_buf="internal" dst_chunk="3"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="3" dst_buf="output" dst_chunk="0"/>

    <!-- AllGather: publish own reduced chunk, pull the others. -->
    <instruction op="D2H" src_buf="output" src_chunk="0" dst_chunk="16" dst_numa="0"/>
    <instruction op="H2D" src_chunk="17" src_numa="0" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="18" src_numa="0" dst_buf="output" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="19" src_numa="0" dst_buf="output" dst_chunk="3"/>
  </rank>

  <rank id="1">
    <!-- ReduceScatter: stage peer-owned chunks. -->
    <instruction op="D2H" src_buf="input" src_chunk="0" dst_chunk="4" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="2" dst_chunk="6" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="3" dst_chunk="7" dst_numa="0"/>
    <instruction op="D2D" src_rank="1" src_buf="input" src_chunk="1" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="1" src_numa="0" dst_buf="internal" dst_chunk="0"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="0" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="9" src_numa="0" dst_buf="internal" dst_chunk="2"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="2" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="13" src_numa="0" dst_buf="internal" dst_chunk="3"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="3" dst_buf="output" dst_chunk="1"/>

    <!-- AllGather: publish own reduced chunk, pull the others. -->
    <instruction op="D2H" src_buf="output" src_chunk="1" dst_chunk="17" dst_numa="0"/>
    <instruction op="H2D" src_chunk="16" src_numa="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="18" src_numa="0" dst_buf="output" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="19" src_numa="0" dst_buf="output" dst_chunk="3"/>
  </rank>

  <rank id="2">
    <!-- ReduceScatter: stage peer-owned chunks. -->
    <instruction op="D2H" src_buf="input" src_chunk="0" dst_chunk="8" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="1" dst_chunk="9" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="3" dst_chunk="11" dst_numa="0"/>
    <instruction op="D2D" src_rank="2" src_buf="input" src_chunk="2" dst_buf="output" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="2" src_numa="0" dst_buf="internal" dst_chunk="0"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="0" dst_buf="output" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="6" src_numa="0" dst_buf="internal" dst_chunk="1"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="1" dst_buf="output" dst_chunk="2"/>
    <instruction op="H2D" src_chunk="14" src_numa="0" dst_buf="internal" dst_chunk="3"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="3" dst_buf="output" dst_chunk="2"/>

    <!-- AllGather: publish own reduced chunk, pull the others. -->
    <instruction op="D2H" src_buf="output" src_chunk="2" dst_chunk="18" dst_numa="0"/>
    <instruction op="H2D" src_chunk="16" src_numa="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="17" src_numa="0" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="19" src_numa="0" dst_buf="output" dst_chunk="3"/>
  </rank>

  <rank id="3">
    <!-- ReduceScatter: stage peer-owned chunks. -->
    <instruction op="D2H" src_buf="input" src_chunk="0" dst_chunk="12" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="1" dst_chunk="13" dst_numa="0"/>
    <instruction op="D2H" src_buf="input" src_chunk="2" dst_chunk="14" dst_numa="0"/>
    <instruction op="D2D" src_rank="3" src_buf="input" src_chunk="3" dst_buf="output" dst_chunk="3"/>
    <instruction op="H2D" src_chunk="3" src_numa="0" dst_buf="internal" dst_chunk="0"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="0" dst_buf="output" dst_chunk="3"/>
    <instruction op="H2D" src_chunk="7" src_numa="0" dst_buf="internal" dst_chunk="1"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="1" dst_buf="output" dst_chunk="3"/>
    <instruction op="H2D" src_chunk="11" src_numa="0" dst_buf="internal" dst_chunk="2"/>
    <instruction op="D2DReduce" src_buf="internal" src_chunk="2" dst_buf="output" dst_chunk="3"/>

    <!-- AllGather: publish own reduced chunk, pull the others. -->
    <instruction op="D2H" src_buf="output" src_chunk="3" dst_chunk="19" dst_numa="0"/>
    <instruction op="H2D" src_chunk="16" src_numa="0" dst_buf="output" dst_chunk="0"/>
    <instruction op="H2D" src_chunk="17" src_numa="0" dst_buf="output" dst_chunk="1"/>
    <instruction op="H2D" src_chunk="18" src_numa="0" dst_buf="output" dst_chunk="2"/>
  </rank>

</ir_program>
